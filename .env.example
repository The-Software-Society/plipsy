# Everything here is optional. With no .env at all the app runs fully
# on-device using the bundled stories, illustrations and narration.

# Optional cloud sync (off by default). Progress only leaves the device when
# EXPO_PUBLIC_ENABLE_CLOUD_SYNC=true AND both Supabase values are set.
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Generation scripts only (never bundled into the app).
# GOOGLE_API_KEY (Google AI Studio) powers BOTH Gemini TTS narration and
# Gemini/Imagen illustrations. Scripts read .env.local first, then .env.
GOOGLE_API_KEY=

# Local-only PIN for the parent dashboard (4 digits). Defaults to 1234 if unset.
# Change it on any shared device.
EXPO_PUBLIC_PARENT_PIN=1234
