# Supabase (read by EXPO_PUBLIC prefix so the client bundles them)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Generation scripts only (never bundled into the app).
# GOOGLE_API_KEY (Google AI Studio) powers BOTH Gemini TTS narration and
# Imagen illustrations. Scripts read .env.local first, then .env.
GOOGLE_API_KEY=

# Local-only PIN for parent dashboard (4 digits). Defaults to 1234 if unset.
EXPO_PUBLIC_PARENT_PIN=1234
